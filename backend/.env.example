HOST=127.0.0.1
PORT=4000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional locally; mandatory in NODE_ENV=production, including behind a proxy.
# Server-to-server / personal development credential. Do not put it in a VITE_ variable.
API_TOKEN=
DATA_FILE=./data/store.json

# Google OAuth: secrets belong only on the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/oauth/google/callback
DASHBOARD_URL=http://localhost:5173
TOKEN_KEY_FILE=./data/token.key

# Refresh all connected channels in the background (5 to 1440 minutes).
SYNC_INTERVAL_MINUTES=30

# Twitch OAuth (Web application)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:4000/api/v1/oauth/twitch/callback

# Kick OAuth 2.1 (PKCE handled by the backend)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:4000/api/v1/oauth/kick/callback

# Parallel channel/video tasks; requests to YouTube are capped at 6.
SYNC_CONCURRENCY=4
# Studios synchronized at the same time (one job per studio); they share the YouTube request cap.
SYNC_WORKSPACES=2
# Automatic cadence per kind of YouTube data (lives and Twitch/Kick follow SYNC_INTERVAL_MINUTES).
# Catalog, playlists and new comments; YouTube Analytics and per-video reports (published with 1-2 days delay).
SYNC_CATALOG_HOURS=6
SYNC_ANALYTICS_HOURS=24
# Rest between two "Sincronizar" clicks of the same studio (0 disables).
SYNC_MANUAL_COOLDOWN_MINUTES=15
# Closed beta: comma-separated invite codes required to create a NEW studio (existing users sign in freely).
# Leave empty for open sign-up.
INVITE_CODES=

# true only behind a local reverse proxy (Nginx) that sets X-Real-IP. Keep false locally.
TRUST_PROXY=false
